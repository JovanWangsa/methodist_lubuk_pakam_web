# Isi .env untuk hosting cPanel. Salin menjadi methodist_lubuk_pakam_web/.env di hosting,
# lalu ganti semua nilai yang ditandai GANTI. Jangan pernah commit file .env asli.

APP_NAME="Sekolah Methodist Lubuk Pakam"
APP_ENV=production
# GANTI: salin APP_KEY dari web/.env di laptop (baris yang diawali base64:)
APP_KEY=
APP_DEBUG=false
APP_URL=https://methodistpakam.sch.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=error

# GANTI: nama database, user, dan password yang dibuat di cPanel > MySQL Databases.
# cPanel menambahkan awalan nama akun, misalnya namaakun_methodist.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=namaakun_methodist
DB_USERNAME=namaakun_web
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email (lupa password admin, nanti email PPDB). GANTI dengan akun dari cPanel > Email Accounts.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.methodistpakam.sch.id
MAIL_PORT=465
MAIL_USERNAME=noreply@methodistpakam.sch.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@methodistpakam.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Akun Super Admin pertama (dipakai seeder). Ganti password setelah login pertama.
ADMIN_EMAIL=admin@methodistpakam.sch.id
ADMIN_PASSWORD=
