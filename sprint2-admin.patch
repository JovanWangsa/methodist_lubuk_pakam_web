diff --git a/web/public/js/admin.js b/web/public/js/admin.js
new file mode 100644
index 0000000..326f5c0
--- /dev/null
+++ b/web/public/js/admin.js
@@ -0,0 +1,74 @@
+// Skrip panel admin (/admin). Tanpa library, tanpa build.
+
+// Menu samping di layar kecil.
+const tombolMenuAdmin = document.querySelectorAll('[data-admin-menu-toggle]');
+const menuAdmin = document.querySelector('[data-admin-menu]');
+
+if (menuAdmin) {
+    const kelasTerbuka = ['flex', 'flex-col', 'fixed', 'inset-y-0', 'left-0', 'z-40', 'w-72', 'shadow-xl'];
+
+    tombolMenuAdmin.forEach((tombol) => tombol.addEventListener('click', () => {
+        const buka = menuAdmin.classList.contains('hidden');
+        menuAdmin.classList.toggle('hidden', !buka);
+        kelasTerbuka.forEach((k) => menuAdmin.classList.toggle(k, buka));
+        tombolMenuAdmin.forEach((t) => t.setAttribute('aria-expanded', String(buka)));
+    }));
+}
+
+// Konfirmasi sebelum menghapus.
+document.querySelectorAll('form[data-konfirmasi]').forEach((form) => {
+    form.addEventListener('submit', (e) => {
+        if (!window.confirm(form.dataset.konfirmasi)) {
+            e.preventDefault();
+        }
+    });
+});
+
+// Pratinjau foto sebelum diunggah.
+document.addEventListener('change', (e) => {
+    const input = e.target.closest('[data-pratinjau-input]');
+    if (!input || !input.files || !input.files[0]) {
+        return;
+    }
+
+    const wadah = input.closest('.a-kartu, .space-y-1, [data-butir]') || document;
+    const img = wadah.querySelector('[data-pratinjau]');
+    if (img) {
+        img.src = URL.createObjectURL(input.files[0]);
+        img.classList.remove('hidden');
+    }
+});
+
+// Daftar di formulir konten: tambah dan hapus item.
+let nomorBaru = Date.now();
+
+const nomori = (daftar) => {
+    daftar.querySelectorAll(':scope > [data-daftar-isi] > [data-butir]').forEach((butir, i) => {
+        const nomor = butir.querySelector(':scope > div > [data-butir-nomor]');
+        if (nomor) {
+            nomor.textContent = 'Item ' + (i + 1);
+        }
+    });
+};
+
+document.querySelectorAll('[data-daftar]').forEach(nomori);
+
+document.addEventListener('click', (e) => {
+    const tambah = e.target.closest('[data-tambah]');
+    if (tambah) {
+        const daftar = tambah.closest('[data-daftar]');
+        const templat = daftar.querySelector(':scope > [data-templat]');
+        const html = templat.innerHTML.split(daftar.dataset.penanda).join(String(nomorBaru++));
+        daftar.querySelector(':scope > [data-daftar-isi]').insertAdjacentHTML('beforeend', html);
+        nomori(daftar);
+        return;
+    }
+
+    const hapus = e.target.closest('[data-hapus]');
+    if (hapus) {
+        const butir = hapus.closest('[data-butir]');
+        const daftar = butir.closest('[data-daftar]');
+        butir.remove();
+        nomori(daftar);
+    }
+});
diff --git a/web/resources/css/admin.css b/web/resources/css/admin.css
new file mode 100644
index 0000000..3397aa1
--- /dev/null
+++ b/web/resources/css/admin.css
@@ -0,0 +1,27 @@
+/*
+ * SUMBER CSS PANEL ADMIN (/admin). Hasil jadinya public/css/admin.css, dibuat terpisah dari
+ * situs.css supaya class admin tidak menambah ukuran CSS halaman publik:
+ *   tailwindcss.exe -c tailwind.admin.config.js -i resources/css/admin.css -o public/css/admin.css --minify
+ */
+@import './fonts.css';
+
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+/* Komponen panel admin. */
+@layer components {
+    .a-kartu { @apply bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container p-space-md md:p-space-lg; }
+    .a-label { @apply block font-label-md text-label-md text-on-surface mb-1; }
+    .a-bantuan { @apply mt-1 font-body-sm text-body-sm text-on-surface-variant; }
+    .a-input { @apply block w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 font-body-md text-body-md text-on-surface placeholder:text-outline focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20; }
+    .a-galat { @apply mt-1 font-body-sm text-body-sm text-error; }
+    .a-tombol { @apply inline-flex items-center justify-center gap-space-xs rounded-lg px-space-md py-2 font-label-lg text-label-lg transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/25 disabled:opacity-50; }
+    .a-tombol-utama { @apply a-tombol bg-primary text-on-primary hover:bg-primary-container; }
+    .a-tombol-kedua { @apply a-tombol bg-surface-container-high text-primary hover:bg-surface-container-highest; }
+    .a-tombol-bahaya { @apply a-tombol bg-error-container text-on-error-container hover:brightness-95; }
+    .a-lencana { @apply inline-flex items-center gap-1 rounded-full px-2 py-0.5 font-label-sm text-label-sm; }
+    .a-tabel { @apply w-full text-left font-body-sm text-body-sm; }
+    .a-tabel th { @apply px-3 py-2 font-label-md text-label-md text-on-surface-variant bg-surface-container-low; }
+    .a-tabel td { @apply px-3 py-3 border-t border-surface-container align-middle; }
+}
diff --git a/web/resources/css/app.css b/web/resources/css/app.css
index 1d07041..6b7ebcf 100644
--- a/web/resources/css/app.css
+++ b/web/resources/css/app.css
@@ -1,79 +1,10 @@
 /*
- * SUMBER CSS. Website memakai hasil jadinya, public/css/situs.css (tanpa npm/Node.js).
+ * SUMBER CSS HALAMAN PUBLIK. Website memakai hasil jadinya, public/css/situs.css (tanpa npm/Node.js).
  * Setelah menambah atau mengubah class Tailwind di view, buat ulang dengan Tailwind CLI
  * standalone v3.4.17 (lihat README bagian "Mengubah tampilan"):
  *   tailwindcss.exe -i resources/css/app.css -o public/css/situs.css --minify
- * Alamat font di bawah relatif terhadap public/css/, sehingga mengarah ke public/fonts/.
- *
- * Font disimpan di server sendiri (tidak memuat Google Fonts).
- * Hanya gaya normal yang dimuat, sama seperti tautan Google Fonts di desain Stitch,
- * sehingga teks miring dibentuk browser persis seperti di desain.
  */
-@font-face {
-    font-family: 'Plus Jakarta Sans';
-    font-style: normal;
-    font-display: swap;
